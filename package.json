{
  "name": "recipe-management-api",
  "version": "1.0.0",
  "description": "Recipe Management and Sharing Platform Backend API",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "start:prod": "node -e \"process.env.NODE_ENV='production'; require('./src/index')\"",
    "env:check": "node scripts/validateEnv.js",
    "env:check:prod": "node -e \"process.env.NODE_ENV='production'; require('./scripts/validateEnv')\"",
    "check": "node --check src/index.js && node --check src/app.js && node --check frontend/app.js",
    "test": "jest --detectOpenHandles",
    "lint": "eslint src",
    "seed": "node src/database/seed.js"
  },
  "keywords": [
    "recipe",
    "management",
    "sharing",
    "platform"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1041.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-validator": "^7.0.0",
    "helmet": "^7.0.0",
    "joi": "^17.9.1",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.22.3"
  },
  "devDependencies": {
    "eslint": "^8.40.0",
    "jest": "^29.5.0",
    "nodemon": "^3.1.14",
    "supertest": "^6.3.3"
  }
}
