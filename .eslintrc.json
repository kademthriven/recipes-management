{
  "env": {
    "commonjs": true,
    "es2021": true,
    "jest": true,
    "node": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 2021
  },
  "rules": {
    "class-methods-use-this": "off",
    "no-console": "off",
    "no-unused-vars": ["error", { "args": "none" }],
    "no-useless-catch": "off"
  }
}
