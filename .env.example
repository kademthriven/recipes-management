# Server Configuration
PORT=5000
NODE_ENV=development
BODY_LIMIT=1mb
ALLOWED_ORIGINS=http://localhost:5000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=recipe_management
DB_USER=root
DB_PASSWORD=your_password
DB_CONNECTION_LIMIT=10

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# AWS S3 Configuration
# Leave these placeholder values for local uploads under /uploads.
# Add real AWS values when you want images stored in S3.
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=recipe-management-bucket
# Optional. Use only if your bucket allows object ACLs.
# AWS_S3_ACL=public-read

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_password

# Application URL
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
